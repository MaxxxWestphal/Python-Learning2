start = time.perf_counter()
target in numbers_dict
dict_time = time.perf_counter() - start
print("List lookup time:", list_time)
print("Dictionary lookup time:", dict_time)
if dict_time < list_time:
print("Dictionary lookup is faster by", list_time - dict_time, "seconds.")
else:
print("List lookup is faster by", dict_time - list_time, "seconds.")




